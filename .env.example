# DeepSeek API key. Get one at https://platform.deepseek.com
# Copy this file to .env and fill in your real key:
#   cp .env.example .env
# NEVER commit the real .env file — it is ignored by git.
DEEPSEEK_API_KEY=your_key_here

# Optional overrides (defaults shown)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_SECONDS=30
# ENVIRONMENT=development


# OpenRouter API key (Day 5 — model comparison via OpenRouter).
# Optional: only needed for the Day 5 tab. Never commit the real value.
OPENROUTER_API_KEY=your_openrouter_key_here

# Day 7 — persistent Agent context (SQLite).
# Relative paths resolve from the working directory.
# In Docker, ./data is bind-mounted to /app/data so the DB survives restarts.
# AGENT_DB_PATH=data/agents.db
# Default OpenRouter model used when an Agent selects provider="openrouter".
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Day 11 — agent memory layers.
# Short-term window size and the small JSON file that persists long-term
# memory across sessions and restarts (only long-term memory is persisted).
# DAY11_WINDOW_SIZE=4
# DAY11_LONG_TERM_PATH=data/day11_long_term_memory.json
# DAY11_CLASSIFIER_MAX_TOKENS=800

# Day 12 — user profile (personalization). Stored separately from the dialog
# and from memory. The profile is applied to every request automatically.
# DAY12_PROFILE_PATH=data/day12_user_profile.json

# Day 14 — mandatory invariants. Stored in their OWN file, separate from the
# conversation history and from the Day 13 task state.
# DAY14_INVARIANTS_PATH=data/day14_invariants.json

# Day 17 — VictoriaLogs MCP tool. VICTORIA_LOGS_BASE_URL is REQUIRED only when
# the Day 17 tab is used; a missing value never breaks startup or Day 16.
# Do NOT commit a real internal URL here — this is a placeholder only.
VICTORIA_LOGS_BASE_URL=https://your-victorialogs.example.com
# Field that stores the service name. Defaults to `service`; VERIFY it against
# your deployment and override if the real pipeline uses a different field.
# VICTORIA_LOGS_SERVICE_FIELD=service
# HTTP timeout (seconds) used by the MCP server when querying VictoriaLogs.
# VICTORIA_LOGS_TIMEOUT_SECONDS=5
# Set to `false` ONLY when VictoriaLogs uses an internal CA absent from the
# public trust store (e.g. corporate network). TLS verification is ON by
# default; never disable it for a public endpoint.
# VICTORIA_LOGS_VERIFY_SSL=true
# PREFERRED secure alternative: path to a CA bundle (PEM) that validates the
# VictoriaLogs certificate. When set it takes precedence over VERIFY_SSL.
# VICTORIA_LOGS_CA_BUNDLE=/certs/internal-ca.crt
# docker-compose only: host directory mounted read-only at /certs.
# VICTORIA_LOGS_CA_DIR=C:/path/to/certs
