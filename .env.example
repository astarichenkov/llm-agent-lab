# DeepSeek API key. Get one at https://platform.deepseek.com
# Copy this file to .env and fill in your real key:
#   cp .env.example .env
# NEVER commit the real .env file — it is ignored by git.
DEEPSEEK_API_KEY=your_key_here

# Optional overrides (defaults shown)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_SECONDS=30
# ENVIRONMENT=development


# OpenRouter API key (Day 5 — model comparison via OpenRouter).
# Optional: only needed for the Day 5 tab. Never commit the real value.
OPENROUTER_API_KEY=your_openrouter_key_here
