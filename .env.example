# DeepSeek API key. Get one at https://platform.deepseek.com
# Copy this file to .env and fill in your real key:
#   cp .env.example .env
# NEVER commit the real .env file — it is ignored by git.
DEEPSEEK_API_KEY=your_key_here

# Optional overrides (defaults shown)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_SECONDS=30
# ENVIRONMENT=development


# OpenRouter API key (Day 5 — model comparison via OpenRouter).
# Optional: only needed for the Day 5 tab. Never commit the real value.
OPENROUTER_API_KEY=your_openrouter_key_here

# Day 7 — persistent Agent context (SQLite).
# Relative paths resolve from the working directory.
# In Docker, ./data is bind-mounted to /app/data so the DB survives restarts.
# AGENT_DB_PATH=data/agents.db
# Default OpenRouter model used when an Agent selects provider="openrouter".
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Day 11 — agent memory layers.
# Short-term window size and the small JSON file that persists long-term
# memory across sessions and restarts (only long-term memory is persisted).
# DAY11_WINDOW_SIZE=4
# DAY11_LONG_TERM_PATH=data/day11_long_term_memory.json
# DAY11_CLASSIFIER_MAX_TOKENS=800

# Day 12 — user profile (personalization). Stored separately from the dialog
# and from memory. The profile is applied to every request automatically.
# DAY12_PROFILE_PATH=data/day12_user_profile.json

# Day 14 — mandatory invariants. Stored in their OWN file, separate from the
# conversation history and from the Day 13 task state.
# DAY14_INVARIANTS_PATH=data/day14_invariants.json

# Day 17 — VictoriaLogs MCP tool. VICTORIA_LOGS_BASE_URL is REQUIRED only when
# the Day 17 tab is used; a missing value never breaks startup or Day 16.
# Do NOT commit a real internal URL here — this is a placeholder only.
VICTORIA_LOGS_BASE_URL=https://your-victorialogs.example.com
# Field that stores the service name. Defaults to `service`; VERIFY it against
# your deployment and override if the real pipeline uses a different field.
# VICTORIA_LOGS_SERVICE_FIELD=service
# HTTP timeout (seconds) used by the MCP server when querying VictoriaLogs.
# VICTORIA_LOGS_TIMEOUT_SECONDS=5
# Set to `false` ONLY when VictoriaLogs uses an internal CA absent from the
# public trust store (e.g. corporate network). TLS verification is ON by
# default; never disable it for a public endpoint.
# VICTORIA_LOGS_VERIFY_SSL=true
# PREFERRED secure alternative: path to a CA bundle (PEM) that validates the
# VictoriaLogs certificate. When set it takes precedence over VERIFY_SSL.
# VICTORIA_LOGS_CA_BUNDLE=/certs/internal-ca.crt
# docker-compose only: host directory mounted read-only at /certs.
# VICTORIA_LOGS_CA_DIR=C:/path/to/certs

# Day 18 — scheduled monitoring. Jobs and run aggregates are stored in this
# SQLite database. Defaults to data/day18/monitoring.db relative to the
# working directory; ./data is bind-mounted to /app/data in Docker so the DB
# survives restarts and container recreation. Only aggregates are stored —
# never raw stage logs or secrets.
# DAY18_MONITORING_DB_PATH=data/day18/monitoring.db

# Day 19 — MCP tool composition pipeline. Generated reports live under this
# single git-ignored root. The run id is validated server-side and the resolved
# path must stay inside the root, so no caller can pick an arbitrary path.
# DAY19_ARTIFACT_ROOT=data/day19/runs

# Day 20 — multi-server MCP orchestration (VictoriaLogs + Gitea + Reports).
# Gitea is READ-ONLY by design: the backend only issues GET requests and the
# repository is FIXED in configuration (the LLM can never choose it).
# Use a dedicated Gitea user with read access to only this repository and a
# token scope limited to read:repository. NEVER commit a real token.
GITEA_BASE_URL=http://192.168.1.48:8108
GITEA_TOKEN=
GITEA_REPOSITORY_OWNER=
GITEA_REPOSITORY_NAME=
GITEA_DEFAULT_BRANCH=main
# HTTP timeout (seconds) used by the Gitea client.
# GITEA_TIMEOUT_SECONDS=10
# Hard cap on the unified diff text returned to the LLM / stored in traces.
# GITEA_MAX_DIFF_CHARS=15000
# Hard cap on commits returned by one recent_commits call.
# GITEA_MAX_COMMITS=20

# Day 20 investigation reports. The investigation id is validated server-side
# and the resolved path must stay inside this single git-ignored root.
# DAY20_ARTIFACT_ROOT=data/day20/investigations
# Orchestration safety limits: maximum LLM tool-calling iterations, total MCP
# tool calls per investigation, and per-tool timeout (seconds).
# DAY20_MAX_TOOL_ITERATIONS=16
# DAY20_MAX_TOTAL_TOOL_CALLS=24
# DAY20_TOOL_TIMEOUT_SECONDS=30

# Day 21 — local Automotive RAG knowledge-base ingestion/indexing.
# Paths are relative to the working directory. The Telegram export is PRIVATE
# and git-ignored; the generated index lives under the git-ignored data/.
# RAG_MANUAL_PATH=docs/xpander/manual
# RAG_TELEGRAM_EXPORT_PATH=docs/xpander/ChatExport
# Chunking parameters (no magic numbers in code).
# RAG_CHUNK_SIZE=1200
# RAG_CHUNK_OVERLAP=200
# RAG_STRUCTURAL_MAX_CHARS=1800
# RAG_STRUCTURAL_MIN_CHARS=400
# Telegram conversation grouping (deterministic strategy).
# RAG_TELEGRAM_GAP_MINUTES=30
# RAG_TELEGRAM_MAX_GROUP_MESSAGES=12
# Embeddings: auto -> ollama (if reachable) -> sentence-transformers -> hashing.
# Never a paid cloud embedding API by default.
# IMPORTANT: when the app runs in Docker, Ollama is a separate process/container.
# Inside the app container `localhost` is the container itself, so use:
#   RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
# (docker-compose.yml already sets this default and adds host.docker.internal.)
# On the host (uvicorn directly) keep http://localhost:11434.
# RAG_EMBEDDING_PROVIDER=auto
# RAG_EMBEDDING_MODEL=bge-m3
# RAG_OLLAMA_BASE_URL=http://localhost:11434
# RAG_OLLAMA_TIMEOUT_SECONDS=120
# Dimension of the built-in offline hashing fallback embedder.
# RAG_EMBEDDING_DIMENSION=384
# RAG_INDEX_PATH=data/day21/rag_index.sqlite3
# RAG_FIXED_INDEX_PATH=data/day21/rag_index_fixed.sqlite3

# Day 22 — first RAG request (No-RAG vs RAG over the Day 21 index).
# Generation is a SEPARATE role from embedding: bge-m3 only produces vectors
# and is never used to generate answers. The generation model is resolved in
# ONE place (app/services/rag/generation/factory.py).
# Provider: "deepseek" (reuses the existing client) or "ollama" (local chat).
RAG_GENERATION_PROVIDER=deepseek
# Empty -> provider default (DEEPSEEK_MODEL for deepseek; required for ollama).
# RAG_GENERATION_MODEL=
# Low temperature keeps the No-RAG vs RAG comparison reproducible.
RAG_GENERATION_TEMPERATURE=0.0
RAG_GENERATION_MAX_TOKENS=1024
RAG_GENERATION_TIMEOUT_SECONDS=120
# Default number of retrieved chunks (validated 1..20 by the API schema).
RAG_TOP_K=5
# Hard cap on the assembled context handed to the generation model.
RAG_CONTEXT_MAX_CHARS=12000
# Day 22 evaluation dataset (tracked) + generated manual grades (git-ignored).
RAG_DAY22_EVALUATION_PATH=data/day22/evaluation_questions.json
RAG_DAY22_RESULTS_PATH=data/day22/evaluation_results.json

# Day 23 — improved retrieval: query rewrite + similarity filtering.
# A wide candidate set is retrieved first, then filtered by similarity before
# the final Top-K is handed to the generation model.
RAG_RETRIEVAL_TOP_K=20
RAG_FINAL_TOP_K=5
# Data-driven default (docs/week5/day23.md): on the 10 Day 22 control
# questions the lowest best-expected-source score was 0.5102, so 0.50 keeps
# every expected source while dropping the weak tail.
RAG_SIMILARITY_THRESHOLD=0.50
# Query rewrite is a second, cheap call to the SAME generation model.
RAG_REWRITE_MAX_TOKENS=200
# Day 23 shares the Day 22 dataset but keeps independent manual grades.
RAG_DAY23_RESULTS_PATH=data/day23/evaluation_results.json
RAG_DAY23_DEMO_QUESTION=Какая жидкость ATF и какой объём предусмотрены для автоматической коробки передач Xpander?

# Day 24 — grounded RAG (citations + anti-hallucination). The grounding gate
# reuses RAG_SIMILARITY_THRESHOLD as the answer threshold (Option A).
RAG_DAY24_RESULTS_PATH=data/day24/evaluation_results.json
RAG_DAY24_NEGATIVE_PATH=data/day24/negative_questions.json
RAG_DAY24_DEMO_QUESTION_MANUAL=Какое давление должно быть в шинах Mitsubishi Xpander размера 205/55R16 при нагрузке 1–5 человек + груз?
RAG_DAY24_DEMO_QUESTION_TELEGRAM=Что владельцы в Telegram называют возможной причиной того, что пластик на Xpander «поплыл»?
RAG_DAY24_DEMO_QUESTION_INSUFFICIENT=Как выполняется адаптация вариатора Xpander диагностическим сканером?
# Day 24 — clickable source links. Optional Telegram permalink base. When set
# it has highest priority and is combined as <base>/<message_id>; forum topics
# use <base>/<topic_id>/<message_id>. Examples:
#   RAG_TELEGRAM_CHAT_LINK_BASE=https://t.me/xpanderRU
#   RAG_TELEGRAM_CHAT_LINK_BASE=https://t.me/c/1234567890
# Leave empty to fall back to the export's public username (if present), then
# to the /c/<id> supergroup form. NEVER commit a private chat link base here.
# RAG_TELEGRAM_CHAT_LINK_BASE=

# Day 25 — stateful mini-chat with RAG + task memory.
# The chat DB is PRIVATE application state and lives separately from the
# Day 21 vector index. Task state is a JSON column in the same DB and is
# never embedded.
DAY25_CHAT_DB_PATH=data/day25/chat.sqlite3
# Recent raw messages sent to the model; long-lived facts live in task state.
DAY25_RECENT_MESSAGES=6
# llm (default) | rules
DAY25_STATE_EXTRACTOR=llm
DAY25_SCENARIOS_PATH=data/day25/scenarios
DAY25_EVAL_RESULTS_PATH=data/day25/evaluation_results.json
DAY25_DEMO_OPENING_QUESTION=Хочу разобраться, почему Mitsubishi Xpander вибрирует при движении на D.

# Day 25 — conversational (multi-turn) retrieval.
# A short follow-up ("что делать?") is made self-contained from the active
# topic + previous question + previous grounded source BEFORE vector search.
# Strong manual hits also pull in their same-document neighbours (real
# indexed chunks only).
RAG_CONTEXT_EXPANSION_ENABLED=true
RAG_CONTEXT_EXPANSION_RADIUS=1
RAG_CONTEXT_EXPANSION_MAX=4
RAG_CONTEXT_EXPANSION_MIN_SCORE=0.55
# Optional separate threshold for the chat pipeline. Leave at the Day 24
# default unless the regression scenarios prove a systematic gap.
RAG_CHAT_SIMILARITY_THRESHOLD=0.50
