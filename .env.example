# DeepSeek API key. Get one at https://platform.deepseek.com
# Copy this file to .env and fill in your real key:
#   cp .env.example .env
# NEVER commit the real .env file — it is ignored by git.
DEEPSEEK_API_KEY=your_key_here

# Optional overrides (defaults shown)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_SECONDS=30
# ENVIRONMENT=development


# OpenRouter API key (Day 5 — model comparison via OpenRouter).
# Optional: only needed for the Day 5 tab. Never commit the real value.
OPENROUTER_API_KEY=your_openrouter_key_here

# Day 7 — persistent Agent context (SQLite).
# Relative paths resolve from the working directory.
# In Docker, ./data is bind-mounted to /app/data so the DB survives restarts.
# AGENT_DB_PATH=data/agents.db
# Default OpenRouter model used when an Agent selects provider="openrouter".
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Day 11 — agent memory layers.
# Short-term window size and the small JSON file that persists long-term
# memory across sessions and restarts (only long-term memory is persisted).
# DAY11_WINDOW_SIZE=4
# DAY11_LONG_TERM_PATH=data/day11_long_term_memory.json
# DAY11_CLASSIFIER_MAX_TOKENS=800

# Day 12 — user profile (personalization). Stored separately from the dialog
# and from memory. The profile is applied to every request automatically.
# DAY12_PROFILE_PATH=data/day12_user_profile.json

# Day 14 — mandatory invariants. Stored in their OWN file, separate from the
# conversation history and from the Day 13 task state.
# DAY14_INVARIANTS_PATH=data/day14_invariants.json
